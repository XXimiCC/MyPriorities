# Адрес Worker, который хранит данные и синхронизирует их между устройствами.
#
# Не задан — приложение работает ровно как раньше: локально, через Telegram
# CloudStorage. Это осознанное поведение, а не заглушка: сеть нужна только для
# синхронизации, и без неё ничего ломаться не должно.
#
# Локально:  VITE_SYNC_URL=http://127.0.0.1:8799  (см. worker/README.md)
# На проде:  адрес развёрнутого Worker.
#
# Не забудьте добавить домен приложения в ALLOWED_ORIGINS в worker/wrangler.toml,
# иначе браузер не выпустит запрос и приложение честно скажет «сеть недоступна».
VITE_SYNC_URL=

# Клиент входа через Telegram для обычного браузера. Совпадает с номером бота,
# тайной не является. Не задан — кнопки входа вне Telegram просто не будет, и
# приложение останется локальным; внутри мини-аппа вход работает без него.
#
# Парный секрет живёт только в секретах Worker:
#   wrangler secret put TELEGRAM_OAUTH_CLIENT_SECRET
#
# Адрес возврата, который надо разрешить боту в BotFather, — КОРЕНЬ приложения
# со слэшем: https://ваш-домен/ . Не отдельный путь: сборка ссылается на свои
# файлы относительно текущего адреса.
VITE_TELEGRAM_CLIENT_ID=

# Куда панель отладки отправляет тикеты. Не задан — панели нет вовсе, и это
# нормальная сборка: приложение от этого не меняется ничем.
#
# Отдельно от VITE_SYNC_URL намеренно, хотя обычно это один и тот же Worker:
# адрес синхронизации гасится в демо (src/demo/mode.ts), и панель молча
# исчезала бы ровно там, где чаще всего смотрят на интерфейс. Не задан —
# приложение само откатывается на VITE_SYNC_URL, см. src/main.tsx.
VITE_DEVKIT_URL=

# Ниже — переменные для командной строки, БЕЗ приставки VITE_. Приставки нет
# намеренно: Vite подставляет в бандл только VITE_*, поэтому токен ниже
# структурно не может уехать в браузер.
#
# Откуда `npm run tickets:pull` забирает тикеты и чем доказывает, что это свои.
# Токен ставится в секреты Worker: wrangler secret put DEVKIT_TOKEN
DEVKIT_URL=
DEVKIT_TOKEN=
