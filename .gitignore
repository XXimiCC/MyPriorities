node_modules/
dist/

# Кэш VitePress. dist/ выше без ведущего слэша, поэтому docs/.vitepress/dist
# он уже покрывает, а cache/ — нет.
docs/.vitepress/cache/

# Снимки расширения VS Code Local History — дубликаты рабочих файлов.
.history/

# Отчёты и следы сквозных проверок: пишутся каждым прогоном заново.
e2e/test-results/
e2e/playwright-report/

# Секреты. Токен бота приложению не нужен и в репозиторий попадать не должен.
.env
.env.*
!.env.example

# Секреты Worker для локального запуска: wrangler читает их отсюда, и здесь
# лежит настоящий токен бота. На проде секреты ставятся `wrangler secret put`.
worker/.dev.vars
!worker/.dev.vars.example

# Локальная D1 и состояние wrangler.
worker/.wrangler/

# Тикеты из встроенной панели отладки: рабочие копии, а не исходники. Внутри —
# кадры экрана с настоящими данными, им в репозитории не место.
.tickets/

# Личные настройки Claude Code: у каждого свои, общими им быть незачем.
.claude/settings.local.json

# Оснастка разовой съёмки сдаваемой фичи (.claude/skills/feature-handoff):
# кадры и скрипт под одну задачу, а не исходники. Постоянные кадры
# документации лежат в docs/public/shots и снимаются tools/shots/scenarios.mjs.
.shots/
tools/shots/*.local.mjs

.vercel/
*.log
npm-debug.log*
.DS_Store
Thumbs.db
