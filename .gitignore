node_modules/
dist/

# Кэш VitePress. dist/ выше без ведущего слэша, поэтому docs/.vitepress/dist
# он уже покрывает, а cache/ — нет.
docs/.vitepress/cache/

# Снимки расширения VS Code Local History — дубликаты рабочих файлов.
.history/

# Секреты. Токен бота приложению не нужен и в репозиторий попадать не должен.
.env
.env.*
!.env.example

# Секреты Worker для локального запуска: wrangler читает их отсюда, и здесь
# лежит настоящий токен бота. На проде секреты ставятся `wrangler secret put`.
worker/.dev.vars
!worker/.dev.vars.example

# Локальная D1 и состояние wrangler.
worker/.wrangler/

.vercel/
*.log
npm-debug.log*
.DS_Store
Thumbs.db
