# Секреты для локального запуска: скопируйте в .dev.vars и подставьте свои.
# На проде эти же значения ставятся отдельно и в файлах не живут:
#   wrangler secret put TELEGRAM_BOT_TOKEN
#   wrangler secret put JWT_SECRET
#   wrangler secret put REPORT_CHAT_ID

# Токен от @BotFather.
TELEGRAM_BOT_TOKEN=123456:AAHreplace-me

# Ключ подписи наших токенов. Любая длинная случайная строка, например:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
JWT_SECRET=replace-me

# Куда слать ночной отчёт и уведомления о новых тикетах. Пусто — не шлём.
REPORT_CHAT_ID=

# Ключ командной строки для тикетов: им `npm run tickets:pull` доказывает, что
# это свои. В бандл приложения не попадает никогда — у панели другая дверь.
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
DEVKIT_TOKEN=
